{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mai-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "triggers": { "crons": ["* * * * *"] },
  // Font files for the app (src/fonts.ts), as scripts/upload-fonts.sh puts them.
  "r2_buckets": [{ "binding": "FONTS", "bucket_name": "mai-fonts" }],
  "secrets": {
    "required": [
      "TURSO_URL",
      "TURSO_TOKEN",
      "CHALLENGE_KEY",
      "REFRESH_TOKEN_KEY",
      "APPLE_CLIENT_ID",
      "APPLE_TEAM_ID",
      "APPLE_SIGN_IN_KEY_ID",
      "APPLE_SIGN_IN_KEY",
    ],
  },
}
